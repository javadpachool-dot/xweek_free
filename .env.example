# OpenAI-compatible API
OPENAI_API_KEY=
# Optional: some gateways expect `apikey` instead of `Bearer`
# OPENAI_AUTH_SCHEME=apikey
# Optional: override the API base URL (e.g. a local OpenAI-compatible server)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# Server
# PORT=3000
# HOST=127.0.0.1
# DATABASE_PATH=./data/xweek.db
# Free deployment (Render + Turso)
# Create a libSQL database at turso.tech, then paste its URL and token here.
# TURSO_DATABASE_URL=libsql://your-db-yourname.turso.io
# TURSO_AUTH_TOKEN=
# On Render, set DATABASE_PATH=/tmp/xweek.db (the local replica is re-synced from Turso).
